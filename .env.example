# Copy thành .env rồi điền giá trị thật. KHÔNG commit .env lên git.
# Windows: Copy-Item .env.example .env   |   macOS/Linux: cp .env.example .env
# Mật khẩu / secret KHÔNG để trong file này: xin file .env của nhóm (hỏi Trực) hoặc tự tạo giá trị mới.
# Thiếu biến bắt buộc thì docker compose báo "Thiếu ... trong .env" và dừng.

# ----- PostgreSQL -----
DB_USERNAME=vsl
DB_PASSWORD=

# ----- MinIO -----
MINIO_USER=minioadmin
MINIO_PASSWORD=

# ----- pgAdmin (giao diện web quản lý Postgres) -----
PGADMIN_EMAIL=admin@vsl.com
PGADMIN_PASSWORD=

# ----- JWT (dùng chung mọi service) -----
# Tạo secret mới: openssl rand -base64 64 | tr -d '\r\n'
JWT_SECRET=

# --- Tích hợp ngoài (để trống = tắt tính năng tương ứng, hệ thống vẫn chạy) ---
# Gemini: kiểm duyệt blog/bình luận + tìm từ đồng nghĩa (ai-service)
GEMINI_API_KEY=
# Resend: gửi email OTP + nhắc streak (identity-service)
RESEND_API_KEY=
# true = cho đăng bài khi ai-service không phản hồi (dev); false = chặn (an toàn, như monolith)
MODERATION_FAIL_OPEN=false
# URL MinIO trình duyệt dùng để xem ảnh/video
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
