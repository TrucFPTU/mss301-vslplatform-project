# Bí mật cho máy ảo (bản chạy thật). Chép thành deploy/.env, điền giá trị thật.
# deploy/.env KHÔNG lên git (.gitignore có ".env"). Lần deploy đầu, push-data.sh / setup chép file này lên máy ảo.

# Tên miền trỏ về IP máy ảo. Không có domain riêng thì dùng tên miễn phí của Azure:
#   <nhãn-dns>.<vùng>.cloudapp.azure.com  (đặt ở VM → Overview → DNS name)
DOMAIN=vsl-demo.southeastasia.cloudapp.azure.com
# Link FE trên Vercel: link chia sẻ bài, nút trong email streak, và https://DOMAIN/ chuyển hướng về đây.
FRONTEND_URL=https://mss301-vclplatform-fe.vercel.app
# Email nhận thông báo hết hạn chứng chỉ HTTPS (Let's Encrypt).
ACME_EMAIL=you@example.com

# Image do GitHub Actions build: ghcr.io/<chủ-repo viết thường>
IMAGE_PREFIX=ghcr.io/trucfptu
IMAGE_TAG=latest

# ----- PostgreSQL -----
DB_USERNAME=vsl
# Tạo: openssl rand -hex 16
DB_PASSWORD=

# ----- MinIO -----
MINIO_USER=vsladmin
MINIO_PASSWORD=

# ----- JWT (dùng chung mọi service) — tạo: openssl rand -base64 64 | tr -d '\r\n'
JWT_SECRET=

# --- Tích hợp ngoài (trống = tắt tính năng) ---
GEMINI_API_KEY=
RESEND_API_KEY=
# Sau khi xác minh domain trên resend.com, vd: SignMentor <no-reply@ten-mien-cua-ban>
RESEND_FROM_EMAIL=
MODERATION_FAIL_OPEN=false
